#!/usr/bin/env bash
#
# wtconf — read one .claude/workspace.conf key, with the defaults the agent
# commands (/next-task, /ship-land) rely on.
#
# The conf is resolved exactly as the launchers resolve it — the main checkout
# first, the current worktree as a fallback — so a branch that adds or edits
# the conf takes effect before it lands.
#
# Usage:
#   wtconf BASE_REF               # -> the ref to hand git, e.g. origin/main
#   wtconf BASE_BRANCH            # -> the bare name a PR targets, e.g. main
#   wtconf BASE_ON_REMOTE         # -> 1 when the base exists on the remote
#   wtconf INERT_PATHS            # -> "" when the project declared none
#   wtconf FOO fallback           # -> any conf key, with a fallback
#   wtconf --agent                # -> shell-quoted KEY=value lines, for eval
#   wtconf --keys                 # -> the agent-facing key names
#
# Every key is optional, and every default is chosen to FAIL SAFE in a repo
# that has no conf at all: no inert paths (so the test suite is never
# skipped), no entry skills (so no menu offers a command that does not
# exist), no rebuild triggers (so an image is never rebuilt unasked).
set -euo pipefail

LIB="${WTKIT_LIB:-$HOME/.local/lib/wtkit}"
if [ ! -f "$LIB/common.sh" ]; then
  LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib/wtkit" && pwd)"
fi
# shellcheck disable=SC1091
. "$LIB/common.sh"

MAIN_ROOT=$(wtkit_main_root) || exit 1
wtkit_load_conf "$MAIN_ROOT"

# The agent-facing key set. The defaults live HERE rather than in common.sh so
# the launchers and the slash commands stay independently versionable.
#
# The three base keys come from one resolution, done by wtkit_load_conf:
#   BASE_REF        the ref to hand git — origin/main, or a bare local branch
#   BASE_BRANCH     the bare name, for what genuinely wants a name (a PR target)
#   BASE_ON_REMOTE  1 or 0 — whether fetching it, or asking a forge about it,
#                   means anything at all
#
# Consumers use BASE_REF and must NOT rebuild "origin/$BASE_BRANCH". A base
# that lives only locally — the integration branch a multi-worktree fan-in
# collects into — has no origin/ form, and reconstructing one is what left
# /next-task, ship-classify and the remove-workspace guard measuring against a
# ref that does not exist.
#
# These are ASSIGNED, not defaulted with :=. That matters: when the run-local
# override (git config wtkit.baseBranch) wins, a BASE_BRANCH the conf also set
# is stale, and := would keep the stale name while BASE_REF moved — the exact
# two-sources-of-truth split this key set exists to remove.
BASE_REF="$DEFAULT_BASE"                # ref /ship-land merges into
BASE_BRANCH="$DEFAULT_BASE_BRANCH"      # its bare name
BASE_ON_REMOTE="$DEFAULT_BASE_ON_REMOTE"
: "${MERGE_METHOD:=--merge}"            # gh pr merge flag: --merge|--squash|--rebase
: "${INERT_PATHS:=}"                    # globs the test suite cannot observe
: "${SHIP_SKILL:=/ship}"                # the skill /ship-land runs; empty = none
: "${TASK_ENTRY_SKILLS:=}"              # /next-task's entry-point menu
: "${VERSION_BUMP_FLOOR:=}"             # lowest segment a normal ship may bump
: "${RESERVED_VERSION_SEGMENT:=}"       # segment reserved for out-of-band hotfixes
: "${REBUILD_TRIGGER_PATHS:=}"          # paths whose change means rebuild the image

AGENT_KEYS="BASE_REF BASE_BRANCH BASE_ON_REMOTE MERGE_METHOD INERT_PATHS SHIP_SKILL TASK_ENTRY_SKILLS
VERSION_BUMP_FLOOR RESERVED_VERSION_SEGMENT REBUILD_TRIGGER_PATHS"

case "${1:-}" in
  --agent)
    for k in $AGENT_KEYS; do printf '%s=%q\n' "$k" "${!k}"; done ;;
  --keys)
    for k in $AGENT_KEYS; do printf '%s\n' "$k"; done ;;
  -h|--help|"")
    sed -n '3,20p' "$0" | sed 's/^#\{1,\} \{0,1\}//' ;;
  *)
    key="$1"
    printf '%s\n' "${!key:-${2:-}}" ;;
esac
