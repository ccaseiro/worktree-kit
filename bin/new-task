#!/usr/bin/env bash
#
# new-task — spin up an isolated, throwaway worktree for one task and launch
# Claude Code in the CURRENT pane.
#
# This is the terminal-side, INTERACTIVE counterpart to the /task slash command
# (which spawns background agents). You run this from your terminal; it creates
# a git worktree + isolated docker stack, then hands the current pane to a
# Claude session that YOU drive (pass --tmux to open a new tmux window instead).
#
# Project-specific bits (docker project name, .env body, post-up command, port
# band, finish hint) come from <repo>/.claude/workspace.conf. Without that file
# the worktree is still created and Claude still launches — only the .env and
# docker layer is skipped.
#
# Usage:
#   new-task <slug> [initial prompt words...]
#
# Options (may appear before or after the slug):
#   --no-docker      Skip building/starting the docker stack (docs-only tasks).
#   --no-launch      Prepare the worktree but don't start Claude.
#   --tmux           Launch Claude in a new tmux window instead of this pane.
#   --base <ref>     Base the worktree on <ref> (default: origin/main).
#   --prefix <p>     Branch prefix (default: feature). Branch = <p>/<slug>.
#   -h | --help      Show this help.
#
# Examples:
#   new-task report-export-csv
#   new-task fix-mobile-nav "the mobile navbar overlaps the logo, fix it"
#   new-task update-readme --no-docker
#
set -euo pipefail

WTKIT_LIB="${WTKIT_LIB:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib/wtkit" 2>/dev/null && pwd)}"
if [ ! -f "${WTKIT_LIB:-}/common.sh" ]; then
  echo "wtkit library not found (looked in '${WTKIT_LIB:-?}'). Set WTKIT_LIB." >&2
  exit 1
fi
# shellcheck disable=SC1091
. "$WTKIT_LIB/common.sh"

# ---- parse options ---------------------------------------------------------
NO_DOCKER=0
NO_LAUNCH=0
USE_TMUX=0
BASE="origin/main"
PREFIX="feature"

# Options may appear before OR after the slug. The first bare (non-option)
# argument is the slug; every bare argument after it is the initial prompt.
SLUG=""
PROMPT_ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --no-docker) NO_DOCKER=1; shift ;;
    --no-launch) NO_LAUNCH=1; shift ;;
    --tmux) USE_TMUX=1; shift ;;
    --base) BASE="${2:?--base needs a ref}"; shift 2 ;;
    --prefix) PREFIX="${2:?--prefix needs a value}"; shift 2 ;;
    -h|--help) sed -n '2,31p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --) shift; while [ $# -gt 0 ]; do PROMPT_ARGS+=("$1"); shift; done ;;
    -*) echo "Unknown option: $1" >&2; exit 2 ;;
    *) if [ -z "$SLUG" ]; then SLUG="$1"; else PROMPT_ARGS+=("$1"); fi; shift ;;
  esac
done

if [ -z "$SLUG" ]; then
  echo "Usage: new-task <slug> [initial prompt...]" >&2
  exit 2
fi
PROMPT="${PROMPT_ARGS[*]:-}"   # optional initial prompt for Claude (may be empty)

# slug must be kebab-case so it is safe as a branch segment, docker project
# name, and postgres db identifier.
if ! printf '%s' "$SLUG" | grep -qE '^[a-z0-9]+(-[a-z0-9]+)*$'; then
  echo "Slug must be kebab-case (lowercase letters, digits, single dashes): '$SLUG'" >&2
  exit 2
fi

# ---- locate the primary (main) checkout + load the repo config -------------
MAIN_ROOT=$(wtkit_main_root)
wtkit_load_conf "$MAIN_ROOT"

STACK_UP=0
WT_DIR="$MAIN_ROOT/.claude/worktrees/$SLUG"
BRANCH="$PREFIX/$SLUG"

if [ -e "$WT_DIR" ]; then
  echo "Worktree already exists: $WT_DIR" >&2
  echo "Pick a different slug, or remove it with: git worktree remove --force '$WT_DIR'" >&2
  exit 1
fi
if git -C "$MAIN_ROOT" show-ref --verify --quiet "refs/heads/$BRANCH"; then
  echo "Branch already exists: $BRANCH (pick another slug or delete the branch)." >&2
  exit 1
fi

# ---- deterministic, collision-checked ports (task band) --------------------
# Offset derived from the slug so a given task always lands on the same ports;
# the host probe in wtkit_alloc_ports bumps it when they are already in use.
SAFE=$(printf '%s' "$SLUG" | tr -c 'a-z0-9' '_')
PROJ="wt_$SAFE"
DBNAME="wt_$SAFE"
if [ "$USE_DOCKER" -eq 1 ]; then
  wtkit_alloc_ports "$TASK_WEB_BASE" "$TASK_DB_BASE" \
    "$(( $(wtkit_hash "$SLUG") % TASK_PORT_SPAN ))" "$TASK_PORT_SPAN" wrap
fi

# ---- create the worktree ---------------------------------------------------
echo "==> Fetching $BASE and creating worktree"
case "$BASE" in
  origin/*) git -C "$MAIN_ROOT" fetch origin "${BASE#origin/}" >/dev/null 2>&1 || true ;;
esac
git -C "$MAIN_ROOT" worktree add "$WT_DIR" -b "$BRANCH" "$BASE"

[ "$USE_DOCKER" -eq 1 ] && [ "$NO_DOCKER" -eq 0 ] && STACK_UP=1
wtkit_write_env "$WT_DIR" "new-task"
wtkit_docker_up "$WT_DIR"
[ "$USE_DOCKER" -eq 1 ] || STACK_UP=0   # docker missing -> nothing was started

# ---- initial guidance message ----------------------------------------------
GUIDANCE="You are in a pre-created isolated git worktree ($BRANCH). Do NOT create \
another worktree. main is the integration point — never commit on it directly."
[ -n "$FINISH_HINT" ] && GUIDANCE="$GUIDANCE $FINISH_HINT"
INIT_MSG="$GUIDANCE"
[ -n "$PROMPT" ] && INIT_MSG="$INIT_MSG"$'\n\n'"Task: $PROMPT"

# ---- summary (printed BEFORE launch so it survives the exec below) ---------
cat <<EOF

✅ Task worktree ready

  Slug:     $SLUG
  Branch:   $BRANCH  (base: $BASE)
  Worktree: $WT_DIR
$( [ "$STACK_UP" -eq 1 ] && echo "  App URL:  http://localhost:$WEB_PORT" )
$( [ "$USE_DOCKER" -eq 1 ] && echo "  Project:  $PROJ  (web:$WEB_PORT db:$DB_PORT)" )
$( [ "$HAS_CONF" -eq 0 ] && echo "  Config:   none (.claude/workspace.conf absent — no .env, no docker)" )

Discard without merging:
  git worktree remove --force '$WT_DIR' && git branch -D '$BRANCH'
EOF

wtkit_launch_claude "$WT_DIR" "$SLUG" "tasks" "$INIT_MSG"
